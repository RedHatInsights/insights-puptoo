{
    "extends": [
        "github>RedHatInsights/konflux-pipelines//renovate/foreman_satellite/renovate.json"
    ],
    "schedule": [
        "on Monday after 3am and before 10am"
    ],
    "tekton": {
        "schedule": ["at any time"]
    },
    "ignorePaths": [
        "requirements-build.txt"
    ],
    "pip_requirements": {
        "postUpgradeTasks": {
            "commands": ["uv lock"],
            "fileFilters": ["uv.lock"],
            "executionMode": "branch"
        }
    }
}
