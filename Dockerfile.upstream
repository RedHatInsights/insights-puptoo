FROM registry.access.redhat.com/ubi10/ubi-minimal:latest

WORKDIR /app-root/

RUN microdnf install --setopt=tsflags=nodocs -y python3 python3-pip which git tar xz bzip2 unzip && \
    microdnf upgrade -y && \
    microdnf clean all

RUN set -ex && if [ -e `which python3` ]; then ln -s `which python3` /usr/local/bin/python; fi

RUN git clone -b 3.0 https://github.com/RedHatInsights/insights-core && \
    pip3 install ./insights-core

COPY uv.lock uv.lock
COPY pyproject.toml pyproject.toml
COPY requirements.txt requirements.txt
COPY unit_test.sh unit_test.sh
COPY dev dev
COPY tests tests
COPY src src

RUN pip3 install --upgrade pip && pip3 install . --ignore-installed

USER 1001

CMD ["puptoo"]
